<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml — Historical Markers Tracker
  Declares the app's two activities: MainActivity (list) and MarkerDetailActivity (detail).
  ACCESS_FINE_LOCATION is declared for optional GPS proximity detection (not required for core use).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Optional: request fine location for proximity-based auto-check-in -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HistoricalMarkers">

        <!-- Main activity: scrollable list of all historical markers -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Detail activity: full info + visit toggle for a single marker -->
        <activity
            android:name=".ui.MarkerDetailActivity"
            android:label="@string/title_marker_detail"
            android:parentActivityName=".ui.MainActivity"
            android:exported="false">
            <meta-data
                android:name="android.support.PARENT_ACTIVITY"
                android:value=".ui.MainActivity" />
        </activity>

    </application>
</manifest>
